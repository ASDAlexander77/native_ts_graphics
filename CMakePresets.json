{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Ninja)",
      "description": "TSLANG custom language requires the Ninja generator (the Visual Studio generator ignores custom languages).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "description": "Ninja is a single-config generator, so Release builds use their own binary directory.",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dlss",
      "displayName": "Default with DLSS (Ninja)",
      "description": "Debug with NVIDIA DLSS (DONUT_WITH_DLSS): Donut fetches the DLSS SDK from GitHub at configure time.",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-dlss",
      "cacheVariables": {
        "DONUT_WITH_DLSS": "ON"
      }
    },
    {
      "name": "release-dlss",
      "displayName": "Release with DLSS (Ninja)",
      "description": "Release with NVIDIA DLSS (DONUT_WITH_DLSS).",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-release-dlss",
      "cacheVariables": {
        "DONUT_WITH_DLSS": "ON"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 Release (Ninja, NDK)",
      "description": "Release for Android x86_64 (the emulator), API 29, Vulkan only. Needs ANDROID_NDK_HOME, and a desktop build first for its ShaderMake.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android-x86_64",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64 Release (Ninja, NDK)",
      "description": "Release for Android arm64-v8a (devices), API 29, Vulkan only. Needs ANDROID_NDK_HOME, and a desktop build first for its ShaderMake.",
      "inherits": "android-x86_64",
      "binaryDir": "${sourceDir}/build-android-arm64",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dlss",
      "configurePreset": "dlss"
    },
    {
      "name": "release-dlss",
      "configurePreset": "release-dlss"
    },
    {
      "name": "android-x86_64",
      "configurePreset": "android-x86_64"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    }
  ]
}
