diff --git a/include/nvrhi/nvrhi.h b/include/nvrhi/nvrhi.h
--- a/include/nvrhi/nvrhi.h
+++ b/include/nvrhi/nvrhi.h
@@ -3095,6 +3095,9 @@
             uint32_t maxRecursionDepth = 1;
             int32_t hlslExtensionsUAV = -1;
             bool allowOpacityMicromaps = false;
+            // Shaders may trace cluster BLASes (BLASes built from CLASes): D3D12's preview
+            // D3D12_RAYTRACING_PIPELINE_FLAG_ALLOW_CLUSTERED_GEOMETRY. Vulkan pipelines always allow them.
+            bool allowClusteredGeometry = false;
 
             PipelineDesc& addShader(const PipelineShaderDesc& value) { shaders.push_back(value); return *this; }
             PipelineDesc& addHitGroup(const PipelineHitGroupDesc& value) { hitGroups.push_back(value); return *this; }
@@ -3104,6 +3107,7 @@
             PipelineDesc& setMaxRecursionDepth(uint32_t value) { maxRecursionDepth = value; return *this; }
             PipelineDesc& setHlslExtensionsUAV(int32_t value) { hlslExtensionsUAV = value; return *this; }
             PipelineDesc& setAllowOpacityMicromaps(bool value) { allowOpacityMicromaps = value; return *this; }
+            PipelineDesc& setAllowClusteredGeometry(bool value) { allowClusteredGeometry = value; return *this; }
         };
 
         class IPipeline;
diff --git a/src/d3d12/d3d12-raytracing.cpp b/src/d3d12/d3d12-raytracing.cpp
--- a/src/d3d12/d3d12-raytracing.cpp
+++ b/src/d3d12/d3d12-raytracing.cpp
@@ -1417,6 +1417,12 @@
         {
             d3dPipelineConfig.Flags = D3D12_RAYTRACING_PIPELINE_FLAG_ALLOW_OPACITY_MICROMAPS;
         }
+        // D3D12_RAYTRACING_PIPELINE_FLAG_ALLOW_CLUSTERED_GEOMETRY: in the preview Agility SDK's headers
+        // (1.722.0-preview) only, so by value.
+        if (desc.allowClusteredGeometry)
+        {
+            d3dPipelineConfig.Flags |= D3D12_RAYTRACING_PIPELINE_FLAGS(0x800);
+        }
 #else
         d3dSubobject.Type = D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG;
         D3D12_RAYTRACING_PIPELINE_CONFIG d3dPipelineConfig = {};
