@@ -231,8 +231,17 @@ nvrhi::BindingSetHandle DepthPass::CreateInputBindingSet(const BufferGroup* buff
 
 nvrhi::BindingSetHandle DepthPass::GetOrCreateInputBindingSet(const BufferGroup* bufferGroup)
 {
+    // A group's vertex buffer can be replaced (one of two written by a compute pass each frame): a set that
+    // binds another one is made again.
+    auto bindsVertexBuffer = [bufferGroup](nvrhi::IBindingSet* bindingSet) {
+        for (const auto& item : bindingSet->getDesc()->bindings)
+            if (item.resourceHandle == bufferGroup->vertexBuffer.Get())
+                return true;
+        return false;
+    };
+
     auto it = m_InputBindingSets.find(bufferGroup);
-    if (it == m_InputBindingSets.end())
+    if (it == m_InputBindingSets.end() || !bindsVertexBuffer(it->second))
     {
         auto bindingSet = CreateInputBindingSet(bufferGroup);
         m_InputBindingSets[bufferGroup] = bindingSet;
