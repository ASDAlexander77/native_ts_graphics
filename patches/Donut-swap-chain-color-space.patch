+static vk::ColorSpaceKHR ToVkColorSpace(SwapChainColorSpace colorSpace)
+{
+    switch (colorSpace)
+    {
+    case SwapChainColorSpace::HDR10: return vk::ColorSpaceKHR::eHdr10St2084EXT;
+    case SwapChainColorSpace::ScRGB: return vk::ColorSpaceKHR::eExtendedSrgbLinearEXT;
+    default: return vk::ColorSpaceKHR::eSrgbNonlinear;
+    }
+}
+
+// The surface takes the swap chain's format in colorSpace (the color spaces but sRGB come with
+// VK_EXT_swapchain_colorspace).
+bool DeviceManager_VK::IsSwapChainColorSpaceSupported(SwapChainColorSpace colorSpace)
+{
+    if (colorSpace == SwapChainColorSpace::SRGB)
+        return true;
+    if (!m_VulkanPhysicalDevice || !m_WindowSurface || !IsVulkanInstanceExtensionEnabled(VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME))
+        return false;
+    const vk::Format format = vk::Format(nvrhi::vulkan::convertFormat(m_DeviceParams.swapChainFormat));
+    const vk::ColorSpaceKHR vkColorSpace = ToVkColorSpace(colorSpace);
+    for (const auto& surfaceFormat : m_VulkanPhysicalDevice.getSurfaceFormatsKHR(m_WindowSurface))
+    {
+        if (surfaceFormat.format == format && surfaceFormat.colorSpace == vkColorSpace)
+            return true;
+    }
+    return false;
+}
