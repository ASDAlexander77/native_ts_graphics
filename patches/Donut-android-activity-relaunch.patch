+void DeviceManager_VK::RecreateWindowSurface()
+{
+    if (!m_VulkanDevice)
+        return;
+
+    // The old surface goes first: a window takes one surface at a time
+    destroySwapChain();
+    if (m_WindowSurface)
+    {
+        m_VulkanInstance.destroySurfaceKHR(m_WindowSurface);
+        m_WindowSurface = nullptr;
+    }
+
+    if (createWindowSurface())
+        createSwapChain();
+}
