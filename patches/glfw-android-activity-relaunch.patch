+// The pointer and the gesture's keys, let go when the window goes (their up events would go to
+// a window that is no more)
+//
+static void releaseInput(_GLFWwindow* window)
+{
+    endGesture(window);
+    _glfwAndroid.ignoreTouch = GLFW_FALSE;
+    if (_glfwAndroid.pointerId >= 0)
+    {
+        _glfwInputMouseClick(window, GLFW_MOUSE_BUTTON_LEFT, GLFW_RELEASE, 0);
+        _glfwAndroid.pointerId = -1;
+    }
+}
