+
+// The Android platform runs in a NativeActivity through android_native_app_glue: its one window
+// is the activity's ANativeWindow, its events come from the activity's looper, and it presents
+// with Vulkan (VK_KHR_android_surface). There is no OpenGL context support. Everything an
+// activity has no notion of (window position, monitors, cursors, joysticks) is the null
+// platform's, which also keeps the window's state (window->null).
+
+#include <android/native_window.h>
+
+GLFWbool _glfwConnectAndroid(int platformID, _GLFWplatform* platform);
