+// The swap chain made again with the same description (DeviceCreationParameters::swapChainRecreationRequested).
+void DeviceManager_DX12::RecreateSwapChain()
+{
+    // The window's size may have changed since the description was made.
+    DXGI_SWAP_CHAIN_DESC1 currentDesc;
+    if (SUCCEEDED(m_SwapChain->GetDesc1(&currentDesc)))
+    {
+        m_SwapChainDesc.Width = currentDesc.Width;
+        m_SwapChainDesc.Height = currentDesc.Height;
+        m_DeviceParams.backBufferWidth = currentDesc.Width;
+        m_DeviceParams.backBufferHeight = currentDesc.Height;
+    }
+
+    BackBufferResizing();
+
+    // Idle GPU (ReleaseRenderTargets waits), then no reference to the old swap chain left.
+    m_SwapChain->SetFullscreenState(false, nullptr);
+    ReleaseRenderTargets();
+    m_SwapChain = nullptr;
+
+    if (m_DeviceParams.swapChainRecreation)
+        m_DeviceParams.swapChainRecreation(true);
+
+    RefCountPtr<IDXGISwapChain1> swapChain1;
+    HRESULT hr = m_DxgiFactory2->CreateSwapChainForHwnd(m_GraphicsQueue, m_hWnd, &m_SwapChainDesc, &m_FullScreenDesc, nullptr, &swapChain1);
+    if (FAILED(hr))
+        donut::log::fatal("CreateSwapChainForHwnd failed (0x%08x)", hr);
+    hr = swapChain1->QueryInterface(IID_PPV_ARGS(&m_SwapChain));
+    if (FAILED(hr))
+        donut::log::fatal("IDXGISwapChain3 not supported (0x%08x)", hr);
+
+    // As the first swap chain: no Alt+Enter from DXGI (GLFW handles full screen).
+    hr = m_DxgiFactory2->MakeWindowAssociation(m_hWnd, DXGI_MWA_NO_ALT_ENTER);
+    if (FAILED(hr))
+        donut::log::warning("MakeWindowAssociation failed (0x%08x)", hr);
+
+    if (!ApplyDxgiColorSpace(m_SwapChain, m_DeviceParams.swapChainColorSpace, true))
+        m_DeviceParams.swapChainColorSpace = m_RequestedSwapChainColorSpace = SwapChainColorSpace::SRGB;
+
+    if (!CreateRenderTargets())
+        donut::log::fatal("CreateRenderTargets failed");
+
+    BackBufferResized();
+
+    if (m_DeviceParams.swapChainRecreation)
+        m_DeviceParams.swapChainRecreation(false);
+}
