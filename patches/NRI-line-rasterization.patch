diff --git a/Include/NRIDescs.h b/Include/NRIDescs.h
index 016de6ff..8badb818 100644
--- a/Include/NRIDescs.h
+++ b/Include/NRIDescs.h
@@ -1201,6 +1201,19 @@ NriStruct(RasterizationDesc) {
     bool conservativeRaster;    // requires "tiers.conservativeRaster != 0"
     bool shadingRate;           // requires "tiers.shadingRate != 0", expects "CmdSetShadingRate" and optionally "AttachmentsDesc::shadingRate"
     float conservativeRasterExtraOverestimation; // VK: "extraPrimitiveOverestimationSize" in pixels (D3D has none)
+
+    // Lines (see "other.lineRasterizationModes" and "other.lineWidthMax"):
+    //  - "lineRasterization": 0 - default, 1 - rectangular, 2 - Bresenham, 3 - smooth (VK: "VkLineRasterizationModeKHR",
+    //    other than default requires the mode's feature; D3D: rectangular = quadrilateral lines ("MultisampleEnable"),
+    //    Bresenham and default = aliased, smooth = alpha antialiased ("AntialiasedLineEnable"))
+    //  - "lineWidth": VK only, 0 or 1 - one pixel wide (wider requires "wideLines")
+    //  - "lineStipple": VK only, each bit of "lineStipplePattern" (from the lowest) a run of "lineStippleFactor" pixels
+    //    drawn if set (requires the mode's stippled lines)
+    uint8_t lineRasterization;
+    bool lineStipple;
+    uint16_t lineStipplePattern;
+    uint32_t lineStippleFactor;
+    float lineWidth;
 };
 
 NriStruct(MultisampleDesc) {
@@ -1841,6 +1854,8 @@ NriStruct(DeviceDesc) {
         uint8_t combinedClipAndCullDistanceMaxNum;
         uint8_t viewMaxNum;                         // multiview is supported if > 1
