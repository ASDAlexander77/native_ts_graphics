+        uint8_t lineRasterizationModes;             // "RasterizationDesc::lineRasterization" modes: 1 rectangular, 2 Bresenham, 4 smooth; 8, 16, 32 the same stippled
+        float lineWidthMax;                         // "RasterizationDesc::lineWidth" max (1 - no wide lines)
     } other;
 
     // Tiers (0 - unsupported)
