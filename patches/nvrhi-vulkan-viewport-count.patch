+    // Sets the viewports and as many scissor rects (Vulkan's counts must match), those missing
+    // covering their viewports, as D3D12's; unless state has no viewports or they didn't change.
+    void setViewportsWithCount(vk::CommandBuffer cmdBuf, const ViewportState& state, const ViewportState& current)
+    {
+        if (state.viewports.empty() || (!arraysAreDifferent(state.viewports, current.viewports)
+            && !arraysAreDifferent(state.scissorRects, current.scissorRects)))
+            return;
+
+        nvrhi::static_vector<vk::Viewport, c_MaxViewports> viewports;
+        nvrhi::static_vector<vk::Rect2D, c_MaxViewports> scissors;
+        for (size_t i = 0; i < state.viewports.size(); i++)
+        {
+            viewports.push_back(VKViewportWithDXCoords(state.viewports[i]));
+            const Rect sc = i < state.scissorRects.size() ? state.scissorRects[i] : Rect(state.viewports[i]);
+            scissors.push_back(vk::Rect2D(vk::Offset2D(sc.minX, sc.minY),
+                vk::Extent2D(std::abs(sc.maxX - sc.minX), std::abs(sc.maxY - sc.minY))));
+        }
+
+        cmdBuf.setViewportWithCount(uint32_t(viewports.size()), viewports.data());
+        cmdBuf.setScissorWithCount(uint32_t(scissors.size()), scissors.data());
+    }
