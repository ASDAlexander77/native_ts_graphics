+        // Resolve attachments (Vulkan): written by the render pass as attachments.
+        if (getDevice()->getGraphicsAPI() == GraphicsAPI::VULKAN)
+        {
+            for (const auto& attachment : desc.colorResolveAttachments)
+            {
+                if (attachment.valid())
