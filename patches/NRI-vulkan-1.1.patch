+VkRenderPass DeviceVK::GetRenderPass(const RenderPassKeyVK& key) {
+    ExclusiveScope lock(m_Lock);
+
+    for (const auto& entry : m_RenderPasses) {
+        if (!memcmp(&entry.first, &key, sizeof(key)))
+            return entry.second;
+    }
+
+    // Loaded and stored in place (dynamic rendering's "LOAD"/"STORE"), in the layouts the attachments are in already
+    std::array<VkAttachmentDescription2, 9> attachments = {};
+    std::array<VkAttachmentReference2, 8> colorRefs = {};
+    VkAttachmentReference2 depthStencilRef = {VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2};
+    uint32_t attachmentNum = 0;
+
+    for (uint32_t i = 0; i < key.colorNum; i++) {
+        VkAttachmentDescription2& attachment = attachments[attachmentNum];
+        attachment = {VK_STRUCTURE_TYPE_ATTACHMENT_DESCRIPTION_2};
+        attachment.format = key.colorFormats[i];
+        attachment.samples = key.samples;
+        attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        attachment.initialLayout = key.colorLayouts[i];
+        attachment.finalLayout = key.colorLayouts[i];
+
+        colorRefs[i] = {VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2};
+        colorRefs[i].attachment = attachmentNum++;
+        colorRefs[i].layout = key.colorLayouts[i];
+        colorRefs[i].aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    }
+
+    bool hasDepthStencil = key.depthStencilFormat != VK_FORMAT_UNDEFINED;
+    if (hasDepthStencil) {
+        VkAttachmentDescription2& attachment = attachments[attachmentNum];
+        attachment = {VK_STRUCTURE_TYPE_ATTACHMENT_DESCRIPTION_2};
+        attachment.format = key.depthStencilFormat;
+        attachment.samples = key.samples;
+        attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        attachment.stencilLoadOp = key.hasStencil ? VK_ATTACHMENT_LOAD_OP_LOAD : VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        attachment.stencilStoreOp = key.hasStencil ? VK_ATTACHMENT_STORE_OP_STORE : VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        attachment.initialLayout = key.depthStencilLayout;
+        attachment.finalLayout = key.depthStencilLayout;
+
+        depthStencilRef.attachment = attachmentNum++;
+        depthStencilRef.layout = key.depthStencilLayout;
+        depthStencilRef.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT | (key.hasStencil ? VK_IMAGE_ASPECT_STENCIL_BIT : 0);
+    }
+
+    VkSubpassDescription2 subpass = {VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_2};
+    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    subpass.viewMask = key.viewMask;
+    subpass.colorAttachmentCount = key.colorNum;
+    subpass.pColorAttachments = colorRefs.data();
+    subpass.pDepthStencilAttachment = hasDepthStencil ? &depthStencilRef : nullptr;
+
+    VkRenderPassCreateInfo2 info = {VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO_2};
+    info.attachmentCount = attachmentNum;
+    info.pAttachments = attachments.data();
+    info.subpassCount = 1;
+    info.pSubpasses = &subpass;
+
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    VkResult vkResult = m_VK.CreateRenderPass2(m_Device, &info, m_AllocationCallbackPtr, &renderPass);
+    if (vkResult != VK_SUCCESS) {
+        REPORT_ERROR(this, "vkCreateRenderPass2 returned %d", (int32_t)vkResult);
+        return VK_NULL_HANDLE;
+    }
+
+    m_RenderPasses.push_back({key, renderPass});
+
+    return renderPass;
+}
+
+VkFramebuffer DeviceVK::GetFramebuffer(const FramebufferKeyVK& key) {
+    ExclusiveScope lock(m_Lock);
+
+    for (const auto& entry : m_Framebuffers) {
+        if (!memcmp(&entry.first, &key, sizeof(key)))
+            return entry.second;
+    }
+
+    VkFramebufferCreateInfo info = {VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    info.renderPass = key.renderPass;
+    info.attachmentCount = key.viewNum;
+    info.pAttachments = key.views.data();
+    info.width = key.width;
+    info.height = key.height;
+    info.layers = key.layerNum;
+
+    VkFramebuffer framebuffer = VK_NULL_HANDLE;
+    VkResult vkResult = m_VK.CreateFramebuffer(m_Device, &info, m_AllocationCallbackPtr, &framebuffer);
+    if (vkResult != VK_SUCCESS) {
+        REPORT_ERROR(this, "vkCreateFramebuffer returned %d", (int32_t)vkResult);
+        return VK_NULL_HANDLE;
+    }
+
+    m_Framebuffers.push_back({key, framebuffer});
+
+    return framebuffer;
+}
+
+void DeviceVK::ForgetImageView(VkImageView view) {
+    ExclusiveScope lock(m_Lock);
+
+    // A framebuffer goes with its views (an app keeps them alive while it renders with them)
+    for (size_t i = 0; i < m_Framebuffers.size(); i++) {
+        const FramebufferKeyVK& key = m_Framebuffers[i].first;
+
+        bool found = false;
+        for (uint32_t j = 0; j < key.viewNum && !found; j++)
+            found = key.views[j] == view;
+
+        if (found) {
+            m_VK.DestroyFramebuffer(m_Device, m_Framebuffers[i].second, m_AllocationCallbackPtr);
+            m_Framebuffers.erase(m_Framebuffers.begin() + i--);
+        }
+    }
+}
