
{
    "compilerOptions": {
      "target": "esnext",
      "allowJs": false,
      "skipLibCheck": true,
      "strict": true,
      // The examples create their objects in init() methods rather than constructors (tslang
      // resolves `this.onX` callbacks only for members declared earlier).
      "strictPropertyInitialization": false,
      "noEmit": true,
      "esModuleInterop": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "jsx": "preserve",
      "incremental": true,
      "lib": ["ESNext"],
      "types": ["./types/tslang", "I:\\tslang/defaultlib/lib.d.ts"]
    },
    "include": ["*.ts"]
}
