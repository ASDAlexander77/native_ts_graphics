    "version": "0.2.0",
    "configurations": [        
        {
            "name": "(Windows) Launch TSLang JIT",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "tslang.exe",
            "args": ["--di", "--opt_level=0", "--shared-libs=build/bin/donut_interop.dll", "${file}", "--", "-dx12"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        }
    ]
}